# Supabase — proyecto de https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pagos (bloque 3 — no integrar todavía; confirmar procesador antes)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Validación del documento del importador (padrón ARCA vía AFIP SDK).
# Default = mock (solo valida formato DNI/CUIT). Para el padrón real:
#   1) npm i @afipsdk/afip.js
#   2) descomentar y completar:
# TAX_ID_VALIDATOR=afipsdk
# AFIP_SDK_ACCESS_TOKEN=      # token de tu cuenta en afipsdk.com
# AFIP_CUIT=                  # CUIT que consulta el padrón (p. ej. Ecomex)
# AFIP_ENV=homologacion       # homologacion (gratis, empezar acá) | produccion

# ── Cobro por transferencia bancaria ──────────────────────────────
# Cotización pesos por dólar (para mostrar el monto en ARS). 0 = sin cotización.
TRANSFER_ARS_RATE=0
# Titular de las cuentas (mismo para ambas)
TRANSFER_TITULAR=
# WhatsApp para recibir el comprobante (internacional sin +, ej. 5491155551234)
TRANSFER_WHATSAPP=
# Cuenta en pesos
TRANSFER_ARS_BANCO=
TRANSFER_ARS_CBU=
TRANSFER_ARS_ALIAS=
# Cuenta en dólares
TRANSFER_USD_BANCO=
TRANSFER_USD_CBU=
TRANSFER_USD_ALIAS=

# ── Tarjeta: Mercado Pago (cuando haya cuenta de comercio) ─────────
# PAYMENT_PROVIDER=mercadopago  (en dev dejar "mock")
# MP_ACCESS_TOKEN=

# ── Login con Google (console.cloud.google.com → Credenciales → ID de cliente OAuth, tipo "Aplicación web")
# URI de redireccionamiento autorizado: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
#   prod: https://www.traelo.ar/api/auth/google/callback · dev: http://localhost:3000/api/auth/google/callback
# Sin estas dos variables el botón "Continuar con Google" no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Emails (recuperar contraseña, confirmación de pago, estados)
# MAILER=console (dev, loguea) | resend (prod; dominio traelo.ar verificado en resend.com)
# RESEND_API_KEY=
# MAIL_FROM="Traelo <hola@traelo.ar>"
